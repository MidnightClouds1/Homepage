# Copy this file to `.env` (same directory as docker-compose.yml) and fill in
# real values there. `.env` is gitignored — never commit it.
#
# docker-compose substitutes ${VAR} references in docker-compose.yml from this
# file. The HOMEPAGE_VAR_* ones are then available inside services.yaml /
# widgets.yaml as {{HOMEPAGE_VAR_...}} — see https://gethomepage.dev/installation/docker/#using-environment-secrets

# ---------------------------------------------------------------------------
# Built-in login (HOMEPAGE_AUTH_ENABLED=true is set directly in docker-compose.yml)
# ---------------------------------------------------------------------------
# Password-only auth has no username field — see chat summary.
HOMEPAGE_AUTH_PASSWORD=
# Generate with: openssl rand -base64 32
HOMEPAGE_AUTH_SECRET=
# Absolute URL you actually use to reach Homepage (must match the browser's address bar)
HOMEPAGE_EXTERNAL_URL=https://homepage.yourdomain.com
# Comma-separated hosts Homepage will accept as Host headers
HOMEPAGE_ALLOWED_HOSTS=homepage.yourdomain.com,LAN_IP_HERE:3000

# ---------------------------------------------------------------------------
# Per-service API keys / tokens (blank = link/widget shows an error until filled in)
# ---------------------------------------------------------------------------
# Jellyfin: Dashboard > Advanced > API Keys
HOMEPAGE_VAR_JELLYFIN_API_KEY=

# Plex: https://www.plexopedia.com/plex-media-server/general/plex-token/
HOMEPAGE_VAR_PLEX_TOKEN=

# Seerr: Settings > General > API Key
HOMEPAGE_VAR_SEERR_API_KEY=

# Tracearr: check its own settings/API section for a key
HOMEPAGE_VAR_TRACEARR_API_KEY=

# Tautulli: Settings > Web Interface > API
HOMEPAGE_VAR_TAUTULLI_API_KEY=

# qBittorrent WebUI login (used instead of an API key — works on all versions)
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=

# Prowlarr: Settings > General > API Key
HOMEPAGE_VAR_PROWLARR_API_KEY=

# Radarr: Settings > General > API Key
HOMEPAGE_VAR_RADARR_API_KEY=

# Sonarr: Settings > General > API Key
HOMEPAGE_VAR_SONARR_API_KEY=

# autobrr: Settings > API Keys
HOMEPAGE_VAR_AUTOBRR_API_KEY=

# Home Assistant: your profile (bottom left) > Security > Long-lived access tokens
HOMEPAGE_VAR_HOMEASSISTANT_TOKEN=

# Immich: Account Settings > API Keys — needs the `server.statistics` permission
HOMEPAGE_VAR_IMMICH_API_KEY=
